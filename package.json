{
  "name": "language-media-editor",
  "version": "1.0.3",
  "description": "Language media editor",
  "author": "yuhjiunn20 <yuhjiunn20@example.com>",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/server.js",
    "electron": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.yuhjiunn20.language-media-editor",
    "productName": "Language Media Editor",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "src/**/*",
      "tools/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "maintainer": "yuhjiunn20 <yuhjiunn20@example.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "mime-types": "^3.0.2",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12",
    "electron": "^41.0.2"
  }
}
